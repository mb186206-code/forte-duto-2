# =====================================================================
# Forte Duto Gestão — variáveis de ambiente
# Copie para .env.local (desenvolvimento) ou cadastre na Vercel (produção).
# =====================================================================

# --- Supabase (obrigatório) -------------------------------------------
# Painel do Supabase → Project Settings → API (ou "Connect").
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave "publishable" (sb_publishable_...). Pode ficar no navegador:
# quem protege os dados é o Row Level Security do banco.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Projetos antigos usam a "anon key" no lugar da publishable (aceita como alternativa):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# --- Endereço público do sistema ---------------------------------------
# Usado nos links de e-mail (recuperação de senha, convites).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Somente servidor (Fase 5: convidar/gerenciar usuários) -------------
# NUNCA use prefixo NEXT_PUBLIC_ e nunca exponha no navegador.
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# --- Integrações futuras (Fase 4+). Ainda NÃO implementadas. -------------
# META_ADS_ACCESS_TOKEN=
# META_ADS_ACCOUNT_ID=
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CUSTOMER_ID=
# WHATSAPP_BUSINESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
