# =====================================================================
# Forte Duto Gestão — variáveis de ambiente
# Copie para .env.local (desenvolvimento) ou cadastre na Vercel (produção).
# NENHUMA delas usa o prefixo NEXT_PUBLIC_: todas ficam só no servidor.
# =====================================================================

# --- Banco de dados (obrigatório) ---------------------------------------
# Painel do Supabase → Project Settings → API Keys / Data API.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave SECRETA (sb_secret_...). Só o servidor usa; nunca vai para o navegador.
# Projetos antigos: use a "service_role key" (aceita também como SUPABASE_SERVICE_ROLE_KEY).
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# --- Código da empresa (recomendado) -------------------------------------
# Digitado uma vez em cada celular. Sem ele, qualquer pessoa com o link entra.
APP_ACCESS_CODE=123456
# Segredo que assina o "passe" do celular (mínimo 32 caracteres, aleatório).
# Gere com: openssl rand -base64 48
# Trocar o código OU o segredo desconecta todos os celulares.
APP_SESSION_SECRET=troque-por-um-texto-aleatorio-com-mais-de-32-caracteres

# --- Integrações futuras (Fase 4+). Ainda NÃO implementadas. -------------
# META_ADS_ACCESS_TOKEN=
# META_ADS_ACCOUNT_ID=
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CUSTOMER_ID=
# WHATSAPP_BUSINESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
